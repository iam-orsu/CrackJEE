# ==============================================================================
# JEENEET.ai Environment Configuration
# Copy to `.env` (root or backend/.env) and fill in real values before running.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:3001
# Optional comma-separated extra allowed browser origins
EXTRA_CORS_ORIGINS=
# Leave unset for automatic (`true` in production HTTPS, `false` in dev HTTP).
# Set to `false` only if testing NODE_ENV=production over plain HTTP.
# COOKIE_SECURE=false

# ── Database (MySQL 8+) ───────────────────────────────────────────────────────
# Local testing example:
#   mysql://root:password@127.0.0.1:3306/jeeneet
# Remote dedicated MySQL server example:
#   mysql://appuser:strong_password@10.0.1.50:3306/jeeneet
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/jeeneet
DB_CONNECTION_LIMIT=10
DB_FANOUT_CONCURRENCY=5

# ── Auth & Security ───────────────────────────────────────────────────────────
# Minimum 16 characters (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_a_random_64_char_string

# ── AI Question Generation (DeepSeek) ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_CONCURRENCY=6

# ── Optional Cache (Redis) ────────────────────────────────────────────────────
# Leave empty or omit for local dev & single-node PM2 (uses built-in in-memory TTL store).
# Set when scaling across multiple backend instances.
# REDIS_URL=redis://:password@127.0.0.1:6379

# ── Super Admin Dashboard (/superadmin) ───────────────────────────────────────
# Generate hash: node -e "require('bcrypt').hash('yourpassword', 12).then(console.log)"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
