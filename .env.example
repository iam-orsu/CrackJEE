# APIs
DEEPSEEK_API_KEY=sk-xxx

# OpenAI — used for question validation
OPENAI_API_KEY=sk-xxx
# Optional: override with a custom proxy base URL (e.g. https://your-proxy.example.com/v1)
OPENAI_BASE_URL=
# Override the model if your proxy routes to a different identifier
OPENAI_MODEL=gpt-4o-mini

# Database — CHANGE THESE, never use defaults in production
POSTGRES_USER=jeeuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://jeeuser:CHANGE_ME_strong_password_here@postgres:5432/jeedb

# Cache — CHANGE THIS password
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379

# Server
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_random_64_char_string

# ── Server address (REQUIRED) ─────────────────────────────────────────────────
# Public IP of your VPS. The app is served on http://<VPS_IP> (port 80).
# docker-compose derives the frontend URL, the API URL and the CORS origin from this.
# deploy.sh refuses to start while this is still the placeholder.
VPS_IP=YOUR_VPS_PUBLIC_IP
