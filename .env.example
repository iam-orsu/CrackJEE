# APIs
DEEPSEEK_API_KEY=sk-xxx

# OpenAI — used for question validation
OPENAI_API_KEY=sk-xxx
# Optional: override with a custom proxy base URL (e.g. https://your-proxy.example.com/v1)
OPENAI_BASE_URL=
# Override the model if your proxy routes to a different identifier
OPENAI_MODEL=gpt-4o-mini

# Database — CHANGE THESE, never use defaults in production
POSTGRES_USER=jeeuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://jeeuser:CHANGE_ME_strong_password_here@postgres:5432/jeedb

# Cache — CHANGE THIS password
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379

# Server
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_random_64_char_string

# ── Super admin dashboard (/superadmin) ───────────────────────────────────────
# Leave empty to disable the dashboard. Pick any email and password for the demo.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Server address (REQUIRED) ─────────────────────────────────────────────────
# Public IP of your VPS. The app is served on https://<VPS_IP> (ports 80→443).
# docker-compose derives the frontend URL, the API URL and the CORS origin from this.
# deploy.sh refuses to start while this is still the placeholder.
VPS_IP=YOUR_VPS_PUBLIC_IP

# ── SSL / TLS ──────────────────────────────────────────────────────────────────
# ENABLE_SSL=false (default) → self-signed certificate via Docker (no host openssl needed)
#                              Works for IP-based access; browsers will show a warning.
# ENABLE_SSL=true            → Let's Encrypt certificate via certbot (requires a real domain)
#                              Port 80 must be reachable from the internet.
#                              Run: ./deploy.sh ssl-setup   to obtain the cert
#                              Run: ./deploy.sh renew-ssl   to renew (every ~60 days)
ENABLE_SSL=false

# Domain name used for the SSL certificate.
# ENABLE_SSL=false → leave empty (VPS_IP is used as the cert CN automatically)
# ENABLE_SSL=true  → set to your real domain, e.g. crackjee.example.com
DOMAIN=

# Email address for Let's Encrypt expiry notices (only required when ENABLE_SSL=true)
SSL_EMAIL=
