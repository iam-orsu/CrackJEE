# APIs
DEEPSEEK_API_KEY=sk-xxx

# OpenAI — used for question validation
OPENAI_API_KEY=sk-xxx
# Optional: override with a custom proxy base URL (e.g. https://your-proxy.example.com/v1)
OPENAI_BASE_URL=
# Override the model if your proxy routes to a different identifier
OPENAI_MODEL=gpt-4o-mini

# Database
POSTGRES_USER=jeeuser
POSTGRES_PASSWORD=jeepassword
DATABASE_URL=postgresql://jeeuser:jeepassword@postgres:5432/jeedb

# Cache
REDIS_URL=redis://redis:6379

# Server
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_random_64_char_string
FRONTEND_URL=http://localhost:3000

# Domain & SSL
DOMAIN=yourdomain.com
VPS_IP=1.2.3.4
EMAIL=admin@yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost
