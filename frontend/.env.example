# ==============================================================================
# CrackJEE Frontend Environment Configuration
# Copy to `frontend/.env.local` (or `frontend/.env`) if overriding defaults.
# ==============================================================================

# Server-side Next.js rewrite destination for `/api/*` requests to the backend
BACKEND_URL=http://127.0.0.1:3001

# Client-side API base path (keep `/api/v1` to route via Next.js rewrite without CORS issues)
NEXT_PUBLIC_API_URL=/api/v1
