# ==============================================================================
# CrackJEE Backend Environment Configuration
# Copy to `backend/.env` and fill in your values before running.
# Note: `backend/.env` takes priority over a root `.env` file.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra allowed browser origins
EXTRA_CORS_ORIGINS=
# Leave unset for automatic (`true` in production HTTPS, `false` in dev HTTP).
# Set to `false` only if testing NODE_ENV=production over plain HTTP.
# COOKIE_SECURE=false

# ── Database (MySQL 8+) ───────────────────────────────────────────────────────
# Local WSL/MySQL testing example:
#   mysql://crackjee:CrackJee_Local123!@127.0.0.1:3306/jeeneet
# Dedicated MySQL server example:
#   mysql://appuser:strong_password@10.0.1.50:3306/jeeneet
DATABASE_URL=mysql://crackjee:CHANGE_ME@127.0.0.1:3306/jeeneet
DB_CONNECTION_LIMIT=10
DB_FANOUT_CONCURRENCY=5

# ── Auth & Security ───────────────────────────────────────────────────────────
# Minimum 16 characters (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_a_random_64_char_secret_key_for_jwt_signing

# ── AI Question Generation (DeepSeek) ─────────────────────────────────────────
# Optional: leave empty to run mocks/practice from the seeded bank only.
DEEPSEEK_API_KEY=
DEEPSEEK_CONCURRENCY=6
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=5
DEEPSEEK_CIRCUIT_COOLDOWN_MS=300000

# ── Optional Cache (Redis) ────────────────────────────────────────────────────
# Leave empty or unset to use the built-in in-memory TTL store.
# Set when scaling across multiple backend instances.
# REDIS_URL=redis://:password@127.0.0.1:6379

# ── Super Admin Dashboard (/superadmin) ───────────────────────────────────────
# Generate hash: node -e "require('bcrypt').hash('yourpassword', 12).then(console.log)"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
