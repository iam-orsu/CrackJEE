generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  class        String
  targetExam   String
  currentLevel String   @default("beginner")
  createdAt    DateTime @default(now())

  attempts       StudentAttempt[]
  topicProgress  TopicProgress[]
  topicMasteries StudentTopicMastery[]
  mockExams      MockExam[]
}

model Topic {
  id           String   @id // e.g. "phy-rotational-motion-11"
  numericCode  Int      @unique @default(autoincrement())
  name         String   @unique
  subject      String   // Physics | Chemistry | Mathematics | Botany | Zoology
  classLevel   String   // "11" | "12"
  examCategory String   // "JEE" | "NEET" | "BOTH"
  syllabusOrder Int     @default(0)
  isExcluded   Boolean  @default(false)

  questions      Question[]
  topicMasteries StudentTopicMastery[]

  @@index([subject, classLevel])
  @@index([examCategory, syllabusOrder])
}

model Question {
  id           String    @id @default(cuid())
  topicId      String?
  topic        String
  subject      String
  questionText String    @db.Text
  options      Json
  answer       String
  explanation       String    @db.Text
  betterExplanation String?   @db.Text
  bestExplanation   String?   @db.Text
  diagram           Json?
  difficulty   String
  examType     String
  questionType String    @default("mcq_single")
  generatedAt  DateTime  @default(now())
  validatedAt  DateTime?
  // True for questions generated for mock exams. Practice and the question bank never serve these,
  // so a live mock's answers cannot be looked up through practice.
  mockOnly     Boolean   @default(false)

  topicRef          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts          StudentAttempt[]
  mockExamQuestions MockExamQuestion[]

  @@index([topicId, difficulty, questionType])
  @@index([topic, subject, difficulty, questionType])
  @@index([subject, difficulty, examType, questionType])
}

model StudentAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  answerSubmitted String   @db.Text
  isCorrect       Boolean
  timeSpent       Int
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([userId, createdAt])
}

model MockExam {
  id              String    @id @default(cuid())
  userId          String
  examType        String    // 'Main' | 'Advanced' | 'NEET'
  difficultyMode  String    @default("medium") // easy | medium | hard
  status          String    @default("generating") // generating | ready | in_progress | submitted | error
  durationSeconds Int
  startedAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions MockExamQuestion[]
  result    MockExamResult?

  @@index([userId])
  @@index([userId, createdAt])
}

model MockExamQuestion {
  id              String  @id @default(cuid())
  examId          String
  questionId      String
  subject         String
  questionNumber  Int
  subjectIndex    Int
  sourceType      String  @default("BASE") // "BASE" | "WEAK_INJECTION"
  savedAnswer     String? @db.Text
  markedForReview Boolean @default(false)

  exam     MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([examId, subject])
}

// A generated paper that any student can be given for its exam type and difficulty.
// items: [{ questionId, subject, questionType, topic? }] in generation order.
model MockPaper {
  id             String   @id @default(cuid())
  examType       String
  difficultyMode String
  items          Json
  // SHA-256 prefix of JSON(topicsBySubject) — lets us find matching papers in O(log n) instead of scanning all
  planKey        String?
  createdAt      DateTime @default(now())

  @@index([examType, difficultyMode])
  @@index([examType, difficultyMode, planKey])
}


model StudentTopicMastery {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  attemptsCount   Int      @default(0)
  correctCount    Int      @default(0)
  accuracyPct     Float    @default(0)
  marksLostTotal  Float    @default(0)
  isWeak          Boolean  @default(false)
  lastTestedAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, isWeak])
  @@index([topicId])
}

model MockExamResult {
  id             String @id @default(cuid())
  examId         String @unique
  totalScore     Float
  maxScore       Int
  physicsScore   Float
  chemistryScore Float
  mathScore      Float
  biologyScore   Float  @default(0)
  correct        Int
  partial        Int      @default(0)
  incorrect      Int
  unattempted    Int
  timeTaken      Int
  scoreBreakdown Json

  exam MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model TopicProgress {
  id            String   @id @default(cuid())
  userId        String
  topicName     String
  subject       String
  attempts      Int      @default(0)
  correctCount  Int      @default(0)
  successRate   Float    @default(0)
  markedAsWeak  Boolean  @default(false)
  lastAttemptAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicName, subject])
  @@index([userId])
  @@index([userId, markedAsWeak])
}

model Faculty {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  papers       FacultyPaper[]
  batches      FacultyBatch[]
  students     FacultyStudent[]
  assignments  FacultyExamAssignment[]
}

model FacultyPaper {
  id            String   @id @default(cuid())
  paperCode     String?  @unique
  facultyId     String
  title         String
  organization  String?
  examType      String
  difficulty    String   @default("intermediate")
  questionCount Int
  selections    Json
  items         Json
  status        String   @default("generating")
  verifiedCount Int      @default(0)
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  faculty     Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  assignments FacultyExamAssignment[]

  @@index([facultyId, createdAt])
}

model FacultyBatch {
  id          String   @id @default(cuid())
  facultyId   String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty     Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students    FacultyStudent[]
  assignments FacultyExamAssignment[]

  @@unique([facultyId, code])
  @@index([facultyId])
}

model FacultyStudent {
  id           String   @id @default(cuid())
  facultyId    String
  batchId      String
  name         String
  rollNumber   String
  email        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculty      Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  batch        FacultyBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  examSessions FacultyStudentExam[]

  @@unique([facultyId, rollNumber])
  @@index([facultyId, batchId])
  @@index([rollNumber])
  @@index([email])
}

model FacultyExamAssignment {
  id              String    @id @default(cuid())
  facultyId       String
  paperId         String
  batchId         String
  title           String
  instructions    String?   @db.Text
  durationMinutes Int       @default(180)
  startTime       DateTime?
  endTime         DateTime?
  showSolutions   Boolean   @default(true)
  status          String    @default("active") // "scheduled" | "active" | "closed"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  faculty         Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  paper           FacultyPaper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  batch           FacultyBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentExams    FacultyStudentExam[]

  @@index([facultyId, batchId])
  @@index([batchId, status])
  @@index([paperId])
}

model FacultyStudentExam {
  id                 String    @id @default(cuid())
  assignmentId       String
  studentId          String
  status             String    @default("not_started") // "in_progress" | "submitted"
  startedAt          DateTime?
  submittedAt        DateTime?
  timeTakenSeconds   Int       @default(0)
  
  // Scoring
  totalScore         Float     @default(0)
  maxScore           Int       @default(0)
  correctCount       Int       @default(0)
  partialCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  unattemptedCount   Int       @default(0)
  
  // Student's responses & question analytics
  answers            Json      // { [questionId]: "A" | "12" | ["A","B"] }
  resultBreakdown    Json?     // Detailed marks, subject scores, accuracy
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignment         FacultyExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student            FacultyStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status, totalScore])
  @@index([assignmentId, totalScore])
  @@index([studentId])
}
