generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  class        String
  targetExam   String
  hasPsychometric Boolean  @default(false)
  currentLevel String   @default("beginner")
  createdAt    DateTime @default(now())

  attempts       StudentAttempt[]
  topicProgress  TopicProgress[]
  topicMasteries StudentTopicMastery[]
  mockExams      MockExam[]
  psychometricSessions PsychometricSession[]
  psychometricReports  PsychometricReport[]
}

model Topic {
  id           String   @id // e.g. "phy-rotational-motion-11"
  numericCode  Int      @unique @default(autoincrement())
  name         String   @unique
  subject      String   // Physics | Chemistry | Mathematics | Botany | Zoology
  classLevel   String   // "11" | "12"
  examCategory String   // "JEE" | "NEET" | "BOTH"
  syllabusOrder Int     @default(0)
  isExcluded   Boolean  @default(false)

  questions      Question[]
  topicMasteries StudentTopicMastery[]

  @@index([subject, classLevel])
  @@index([examCategory, syllabusOrder])
}

model Question {
  id           String    @id @default(cuid())
  topicId      String?
  topic        String
  subject      String
  questionText String    @db.Text
  options      Json
  answer       String
  explanation       String    @db.Text
  betterExplanation String?   @db.Text
  bestExplanation   String?   @db.Text
  diagram           Json?
  difficulty   String
  examType     String
  questionType String    @default("mcq_single")
  generatedAt  DateTime  @default(now())
  validatedAt  DateTime?
  // True for questions generated for mock exams. Practice and the question bank never serve these,
  // so a live mock's answers cannot be looked up through practice.
  mockOnly     Boolean   @default(false)

  topicRef          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts          StudentAttempt[]
  mockExamQuestions MockExamQuestion[]

  @@index([topicId, difficulty, questionType])
  @@index([topic, subject, difficulty, questionType])
  @@index([subject, difficulty, examType, questionType])
}

model StudentAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  answerSubmitted String   @db.Text
  isCorrect       Boolean
  timeSpent       Int
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([userId, createdAt])
}

model MockExam {
  id              String    @id @default(cuid())
  userId          String
  examType        String    // 'Main' | 'Advanced' | 'NEET'
  difficultyMode  String    @default("medium") // easy | medium | hard
  status          String    @default("generating") // generating | ready | in_progress | submitted | error
  durationSeconds Int
  startedAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions MockExamQuestion[]
  result    MockExamResult?

  @@index([userId])
  @@index([userId, createdAt])
}

model MockExamQuestion {
  id              String  @id @default(cuid())
  examId          String
  questionId      String
  subject         String
  questionNumber  Int
  subjectIndex    Int
  sourceType      String  @default("BASE") // "BASE" | "WEAK_INJECTION"
  savedAnswer     String? @db.Text
  markedForReview Boolean @default(false)

  exam     MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([examId, subject])
}

// A generated paper that any student can be given for its exam type and difficulty.
// items: [{ questionId, subject, questionType, topic? }] in generation order.
model MockPaper {
  id             String   @id @default(cuid())
  examType       String
  difficultyMode String
  items          Json
  // SHA-256 prefix of JSON(topicsBySubject) — lets us find matching papers in O(log n) instead of scanning all
  planKey        String?
  createdAt      DateTime @default(now())

  @@index([examType, difficultyMode])
  @@index([examType, difficultyMode, planKey])
}


model StudentTopicMastery {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  attemptsCount   Int      @default(0)
  correctCount    Int      @default(0)
  accuracyPct     Float    @default(0)
  marksLostTotal  Float    @default(0)
  isWeak          Boolean  @default(false)
  lastTestedAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, isWeak])
  @@index([topicId])
}

model MockExamResult {
  id             String @id @default(cuid())
  examId         String @unique
  totalScore     Float
  maxScore       Int
  physicsScore   Float
  chemistryScore Float
  mathScore      Float
  biologyScore   Float  @default(0)
  correct        Int
  partial        Int      @default(0)
  incorrect      Int
  unattempted    Int
  timeTaken      Int
  scoreBreakdown Json

  exam MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model TopicProgress {
  id            String   @id @default(cuid())
  userId        String
  topicName     String
  subject       String
  attempts      Int      @default(0)
  correctCount  Int      @default(0)
  successRate   Float    @default(0)
  markedAsWeak  Boolean  @default(false)
  lastAttemptAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicName, subject])
  @@index([userId])
  @@index([userId, markedAsWeak])
}

model Faculty {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  papers       FacultyPaper[]
  batches      FacultyBatch[]
  students     FacultyStudent[]
  assignments  FacultyExamAssignment[]
}

model FacultyPaper {
  id            String   @id @default(cuid())
  paperCode     String?  @unique
  facultyId     String
  title         String
  organization  String?
  examType      String
  difficulty    String   @default("intermediate")
  questionCount Int
  selections    Json
  items         Json
  status        String   @default("generating")
  verifiedCount Int      @default(0)
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  faculty     Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  assignments FacultyExamAssignment[]

  @@index([facultyId, createdAt])
}

model FacultyBatch {
  id          String   @id @default(cuid())
  facultyId   String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty     Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students    FacultyStudent[]
  assignments FacultyExamAssignment[]

  @@unique([facultyId, code])
  @@index([facultyId])
}

model FacultyStudent {
  id           String   @id @default(cuid())
  facultyId    String
  batchId      String
  name         String
  rollNumber   String
  email        String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculty      Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  batch        FacultyBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  examSessions FacultyStudentExam[]

  @@unique([facultyId, rollNumber])
  @@index([facultyId, batchId])
  @@index([rollNumber])
  @@index([email])
}

model FacultyExamAssignment {
  id              String    @id @default(cuid())
  facultyId       String
  paperId         String
  batchId         String
  title           String
  instructions    String?   @db.Text
  durationMinutes Int       @default(180)
  startTime       DateTime?
  endTime         DateTime?
  showSolutions   Boolean   @default(true)
  status          String    @default("active") // "scheduled" | "active" | "closed"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  faculty         Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  paper           FacultyPaper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  batch           FacultyBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentExams    FacultyStudentExam[]

  @@index([facultyId, batchId])
  @@index([batchId, status])
  @@index([paperId])
}

model FacultyStudentExam {
  id                 String    @id @default(cuid())
  assignmentId       String
  studentId          String
  status             String    @default("not_started") // "in_progress" | "submitted"
  startedAt          DateTime?
  submittedAt        DateTime?
  timeTakenSeconds   Int       @default(0)
  
  // Scoring
  totalScore         Float     @default(0)
  maxScore           Int       @default(0)
  correctCount       Int       @default(0)
  partialCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  unattemptedCount   Int       @default(0)
  
  // Student's responses & question analytics
  answers            Json      // { [questionId]: "A" | "12" | ["A","B"] }
  resultBreakdown    Json?     // Detailed marks, subject scores, accuracy
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignment         FacultyExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student            FacultyStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status, totalScore])
  @@index([assignmentId, totalScore])
  @@index([studentId])
}

// ==========================================
// Psychometric & Behavioral Assessment Engine
// ==========================================

model PsychometricItem {
  id             String   @id @default(cuid())
  section        String   // "COGNITIVE" | "BEHAVIORAL" | "ANXIETY" | "SJT" | "RIASEC"
  construct      String   // e.g., "CONSCIENTIOUSNESS", "NUMERICAL", "TEST_ANXIETY", "ETHICS", etc.
  subFacet       String?
  itemType       String   // "LIKERT_5" | "LIKERT_4" | "SCENARIO_LIKERT_5" | "COGNITIVE_MCQ" | "RIASEC_RATING"
  scenarioText   String?  @db.Text
  promptText     String   @db.Text
  options        Json?    // [{ id: "A", text: "..." }]
  correctAnswer  String?  // For cognitive MCQs
  isReverseKeyed Boolean  @default(false)
  orderIndex     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  responses      PsychometricResponse[]

  @@index([section, construct])
}

model PsychometricSession {
  id               String    @id @default(cuid())
  userId           String
  status           String    @default("in_progress") // "in_progress" | "completed"
  currentSection   String    @default("COGNITIVE")
  timeTakenSeconds Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses        PsychometricResponse[]
  report           PsychometricReport?

  @@index([userId, status])
}

model PsychometricResponse {
  id          String   @id @default(cuid())
  sessionId   String
  itemId      String
  answer      String   // "1".."5", "A", etc.
  score       Float    // reverse-keyed or scored numeric value
  timeSpentMs Int      @default(0)
  createdAt   DateTime @default(now())

  session     PsychometricSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item        PsychometricItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, itemId])
  @@index([sessionId])
}

model PsychometricReport {
  id                   String   @id @default(cuid())
  sessionId            String   @unique
  userId               String
  cognitivePercentile  Float    @default(0)
  cognitiveBreakdown   Json     // { numerical: 80, logical: 85, abstract: 75, spatial: 70 }
  oceanProfile         Json     // { openness: 78, conscientiousness: 88, extraversion: 52, agreeableness: 70, neuroticism: 40 }
  honestyHumility      Float    @default(0) // HEXACO H factor
  testAnxietyIndex     Float    @default(0) // TAI 0-100
  academicResilience   Float    @default(0) // ARS-30 0-100
  sjtCompetencies      Json     // { decisionMaking: 80, academicEthics: 85, stressTolerance: 75 }
  riasecCode           String   @default("IRE")
  riasecScores         Json     // { R: 28, I: 38, A: 14, S: 18, E: 24, C: 22 }
  streamRecommendations Json    // [{ stream: "Computer Science & AI", matchPct: 95 }, ...]
  studyHabitAdvice     Json     // ["...", "..."]
  burnoutRisk          String   @default("low") // "low" | "moderate" | "high"
  facultyAdvice        String?  @db.Text
  createdAt            DateTime @default(now())

  session              PsychometricSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

